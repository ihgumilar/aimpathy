from fastapi import FastAPI, UploadFile, File, Form, HTTPException, WebSocket
from fastapi.middleware.cors import CORSMiddleware
from typing import Dict, Optional
import os
import json
import traceback
from pydantic import BaseModel

app = FastAPI()

# Configure CORS
app.add_middleware(
    CORSMiddleware,
    allow_origins=["http://localhost:3000", "http://localhost:5173"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"]
)

# Store active WebSocket connections
active_connections: Dict[str, WebSocket] = {}

@app.websocket("/api/ws")
async def websocket_endpoint(websocket: WebSocket):
    await websocket.accept()
    socket_id = str(id(websocket))
    active_connections[socket_id] = websocket
    print(f"WebSocket connected: {socket_id}")
    
    try:
        while True:
            data = await websocket.receive_text()
            print(f"Received WebSocket message: {data}")
    except Exception as e:
        print(f"WebSocket error: {e}")
    finally:
        if socket_id in active_connections:
            del active_connections[socket_id]
        print(f"WebSocket disconnected: {socket_id}")

@app.post("/api/upload")
async def upload_file(
    file: UploadFile = File(...),
    socket_id: str = Form(None)
):
    try:
        print(f"Received upload request. Socket ID: {socket_id}")
        
        # Send progress through WebSocket if available
        if socket_id in active_connections:
            websocket = active_connections[socket_id]
            await websocket.send_json({
                "type": "progress",
                "data": {
                    "progress": 0,
                    "step": "Starting upload"
                }
            })
        
        # Process the file here
        print(f"Processing file: {file.filename}")
        
        # Send completion message
        if socket_id in active_connections:
            websocket = active_connections[socket_id]
            await websocket.send_json({
                "type": "progress",
                "data": {
                    "progress": 100,
                    "step": "Upload complete"
                }
            })
        
        return {"message": "File uploaded successfully"}
        
    except Exception as e:
        print(f"Upload error: {e}")
        raise HTTPException(status_code=500, detail=str(e))

@app.post("/api/query")
async def query(body: dict):
    try:
        session_id = body.get('session_id')
        query = body.get('query')
        
        if not session_id or not query:
            raise HTTPException(
                status_code=400, 
                detail="Both session_id and query are required"
            )
            
        print(f"Received query request. Session ID: {session_id}, Query: {query}")
        
        # For testing, echo back the query
        return {
            "response": f"Received query: {query}",
            "session_id": session_id
        }
        
    except Exception as e:
        print(f"Query error: {e}")
        traceback.print_exc()
        raise HTTPException(status_code=500, detail=str(e)) 